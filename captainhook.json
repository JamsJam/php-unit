{
    "pre-commit": {
        "enabled": true,
        "actions": [
            {
                "action": "vendor/bin/php-cs-fixer fix"
            },
            {
                "action": "git add ."
            }
        ]
    },
    "pre-push": {
        "enabled": true,
        "actions": [
            {
                "action": "bash -c 'vendor/bin/phpstan analyse src || { echo \"Erreur détectée ! Push annulé !\"; exit 1; }'"
            }
        ]
    }
}