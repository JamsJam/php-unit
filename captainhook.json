{
    "commit-msg": {
        "enabled": true,
        "actions": []
    },
    "pre-commit": {
        "enabled": true,
        "actions": [
            {
                "action": "vendor/bin/php-cs-fixer fix src --rules=@PSR12"
            }
        ]
    },
    "pre-push": {
        "enabled": true,
        "actions": [
            {
                "action": "bash -c 'vendor/bin/phpstan analyse src || { echo \"Erreur détectée ! Push annulé !\"; exit 1; }'"
            }
        ]
    }
}